```{=html}
<%
const hasValue = (value) => value && value !== "NA";
const hasText = (value) => hasValue(value) && value.trim() !== "";
%>
<ul class="list ps-3 mb-0" style="list-style: disc; line-height: 1.25;">
  <% for (const item of items) { %>
    <li class="mb-2" <%= metadataAttrs(item) %>>
      <div class="listing-title">
        <% if (hasValue(item.url)) { %><a href="<%- item.url %>"><%= item.title %></a><% } else { %><%= item.title %><% } %>
        <span class="listing-date small" style="margin-top: 0.1rem;">(<%= item.date %>)</span>
      </div>
      <div class="listing-description small" style="margin-top: 0.15rem;">
        <% if (hasValue(item.meeting)) { %><i><%= item.meeting %></i><% } %><% if (hasValue(item.source)) { %><% if (hasValue(item.meeting)) { %>, <% } %><%= item.source %><% } %><% if (hasValue(item.meeting) || hasValue(item.source)) { %>.<% } %>
        <% if (hasValue(item.file)) { %>
          <span class="listing-meta text-muted">
            •
            <a href="<%- item.file %>">pdf</a>
          </span>
        <% } %>
      </div>
      <% if (hasText(item.abstract)) { %>
        <details style="margin-top: 0.2rem; margin-bottom: 0;">
          <summary>Summary</summary>
          <div class="listing-abstract"><%= item.abstract.trim() %></div>
        </details>
      <% } %>
    </li>
  <% } %>
</ul>
```
