```{=html}
<ul class="list" style="line-height: 1.2;">
  <% for (const item of items) { %>
    <li class="list-item" style="margin-bottom: 2px;" <%=metadataAttrs(item) %>>
      <b><%= item.title %></b> (<%= item.authors %>, <%= item.date %>). <a href="<%= item.url %>"><%= item.source %></a>, <a href="<%= item.file %>">PDF</a>
      <% if(item.abstract) { %>
        <details>
          <summary>Abstract</summary>
          <div class="listing-abstract">
            <%= item.abstract %>
          </div>
        </details>
      <% } %>
    </li>
  <% } %>
</ul>
```
